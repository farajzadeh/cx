#!/usr/bin/env bash
# cx-agent — the server half of cx.
#
# DELIBERATELY MONOLITHIC. This file is scp'd to servers as a single artifact,
# so it must not source anything outside itself. Resist the urge to factor it
# into lib/ — that dependency cannot be satisfied on the far end.
#
# CONTRACT
#   stdout  machine-readable (JSON, or a bare value for `path`)
#   stderr  human-readable progress and errors
#   exit    0 ok, 1 error, 2 not found, 3 usage, 4 conflict
#
# This split is what lets the client consume output while errors still reach
# the user's terminal.
#
# The client never builds shell command strings for this script — it passes
# arguments, quoted individually. All quoting lives on the client side of the
# wire; by the time we get here, "$1" is one intact argument no matter what
# characters it contains.
#
# Targets bash 3.2 for consistency with the client. See docs/ARCHITECTURE.md.

set -eu

# 0.2.0 added --worktree/--session to open, stop, ask and path, plus the
# worktree subcommand. 0.2.1 added --dangerous to open and ask. 0.3.0 added
# --permission-mode/--model/--effort, `--` passthrough, ask's print-mode
# options, and recorded perm_mode in place of the `dangerous` boolean; plus
# observe, nudge, goal and open --detach. The client feature-gates on this: an
# older agent would reject the new flags and verbs as unknown options, which
# says nothing about needing to re-provision.
CX_AGENT_VERSION="0.3.0"

CX_DATA_DIR="${CX_DATA_DIR:-$HOME/.local/share/cx}"
CX_REGISTRY="${CX_REGISTRY:-$CX_DATA_DIR/projects.json}"
CX_CLAUDE_DIR="${CX_CLAUDE_DIR:-$HOME/.claude}"
CX_LOCK_DIR="$CX_DATA_DIR/.lock"
CX_TMUX_PREFIX="cx-"

# Named sessions map to pinned Claude conversation ids here. See the "Session
# identity" section below for why this file has to exist.
CX_SESSIONS="${CX_SESSIONS:-$CX_DATA_DIR/sessions.json}"

# What each session is FOR. Unlike everything else the server keeps, a goal
# cannot be derived from anything — not from git, not from tmux, not from the
# conversation. It is the one thing here that only a human can supply, which
# is exactly why invariant 5 says the server should hold it.
CX_GOALS="${CX_GOALS:-$CX_DATA_DIR/goals.json}"

# Worktrees live in a hidden directory beside the project, one subdirectory per
# project, so `ls ~/projects` stays readable and `rm --purge` is one removal.
CX_WORKTREE_DIR=".worktrees"

# The agent is invoked as `ssh host '$HOME/.local/bin/cx-agent ...'`, which is
# a NON-INTERACTIVE, NON-LOGIN shell: it reads neither ~/.bashrc nor
# ~/.profile. So the PATH additions those files make are absent, and
# ~/.local/bin — where Claude Code installs itself — is not searched.
#
# Without this, `command -v claude` fails here even though it works perfectly
# when the same user SSHes in by hand, and cx reports "Claude Code not
# installed" on a server where it is installed and signed in.
PATH="$HOME/.local/bin:$HOME/.claude/local:$PATH"
export PATH

log() { printf '%s\n' "$*" >&2; }
die() {
  printf 'cx-agent: %s\n' "$1" >&2
  exit "${2:-1}"
}
have() { command -v "$1" >/dev/null 2>&1; }

# cx_q — single-quote a value for a shell command we hand to tmux send-keys.
cx_q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\''/g")"; }

# ---------------------------------------------------------------------------
# Portability (self-contained; mirrors lib/compat.sh)
# ---------------------------------------------------------------------------

if stat -c %Y . >/dev/null 2>&1; then # portable-ok: this IS the probe
  _STAT=gnu
elif stat -f %m . >/dev/null 2>&1; then
  _STAT=bsd
else
  _STAT=none
fi

_mtime() {
  [ -e "$1" ] || return 1
  case "$_STAT" in
    gnu) stat -c %Y -- "$1" 2>/dev/null ;; # portable-ok: guarded by probe
    bsd) stat -f %m -- "$1" 2>/dev/null ;;
    *) date -r "$1" +%s 2>/dev/null ;;
  esac
}

# mkdir is atomic on every POSIX filesystem; flock is Linux-only.
_lock() {
  local i=0
  while [ "$i" -lt 50 ]; do
    if mkdir "$CX_LOCK_DIR" 2>/dev/null; then
      printf '%s' $$ >"$CX_LOCK_DIR/pid" 2>/dev/null || true
      return 0
    fi
    # Reap a lock whose owner died mid-write.
    local pid age
    pid=$(cat "$CX_LOCK_DIR/pid" 2>/dev/null || printf '')
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      age=$(($(date +%s) - $(_mtime "$CX_LOCK_DIR" 2>/dev/null || printf 0)))
      [ "$age" -gt 30 ] && rm -rf "$CX_LOCK_DIR" 2>/dev/null || true
    fi
    i=$((i + 1))
    sleep 0.1
  done
  die "could not acquire the registry lock (is another cx command stuck?)" 1
}

_unlock() { rm -rf "$CX_LOCK_DIR" 2>/dev/null || true; }

# Every registry write goes through this. The rename is atomic, so a reader
# sees either the whole old file or the whole new one — never a truncation.
_write_atomic() {
  local dest="$1" tmp
  tmp="$(dirname "$dest")/.cx.tmp.$$"
  cat >"$tmp" || {
    rm -f "$tmp"
    return 1
  }
  mv -f "$tmp" "$dest" || {
    rm -f "$tmp"
    return 1
  }
}

# ---------------------------------------------------------------------------
# Registry
# ---------------------------------------------------------------------------

_registry_ensure() {
  [ -e "$CX_REGISTRY" ] && return 0
  mkdir -p "$(dirname "$CX_REGISTRY")"
  printf '{"version":1,"root":"%s","projects":[]}\n' "$HOME/projects" |
    _write_atomic "$CX_REGISTRY"
}

_registry_root() {
  _registry_ensure
  jq -r '.root // empty' "$CX_REGISTRY" 2>/dev/null || printf '%s/projects' "$HOME"
}

_project_get() {
  jq -c --arg n "$1" '.projects[] | select(.name == $n)' "$CX_REGISTRY" 2>/dev/null
}

_project_path() {
  _project_get "$1" | jq -r '.path // empty'
}

# Names become directory names, tmux session names, and JSON keys. Reject
# anything that would be ambiguous or escape the project root.
_validate_name() {
  local n="$1"
  [ -n "$n" ] || die "project name cannot be empty" 3
  case "$n" in
    */* | *'	'* | *' '*) die "project name cannot contain spaces, tabs or slashes: $n" 3 ;;
    .. | . | -*) die "invalid project name: $n" 3 ;;
    # Reserved: this is the directory worktrees are kept in, so a project of
    # the same name would sit on top of them.
    "$CX_WORKTREE_DIR") die "'$n' is reserved for worktree storage" 3 ;;
    *[!A-Za-z0-9._-]*) die "project name may only contain letters, digits, dot, underscore and hyphen: $n" 3 ;;
  esac
}

# _validate_label KIND NAME — worktree names and session labels.
#
# Stricter than _validate_name by one character: no dot. tmux silently rewrites
# a dot in a session name to an underscore (verified: `new-session -s cx-my.app`
# yields cx-my_app), which makes the tmux name unmappable back to the thing it
# names. Project names predate cx and must keep accepting dots, so _tmux_slug
# below handles that case by lookup — but for the two namespaces cx introduces
# we can simply keep the mangling from ever arising.
_validate_label() {
  local kind="$1" n="$2"
  [ -n "$n" ] || die "$kind cannot be empty" 3
  case "$n" in
    -*) die "$kind cannot start with a hyphen: $n" 3 ;;
    *[!A-Za-z0-9_-]*)
      die "$kind may only contain letters, digits, underscore and hyphen: $n" 3
      ;;
  esac
}

# Claude Code's own choice lists. Validated here as well as in the client so
# a typo is a sentence rather than a pane that exits before you can read it.
# Deliberately not validating --model: aliases, full ids and future models all
# arrive here, and a stale allowlist would reject a model that works.
_validate_perm_mode() {
  case "$1" in
    acceptEdits | auto | bypassPermissions | manual | dontAsk | plan) ;;
    *) die "unknown permission mode: $1 (acceptEdits, auto, bypassPermissions, manual, dontAsk, plan)" 3 ;;
  esac
}

_validate_effort() {
  case "$1" in
    low | medium | high | xhigh | max) ;;
    *) die "unknown effort level: $1 (low, medium, high, xhigh, max)" 3 ;;
  esac
}

# ---------------------------------------------------------------------------
# Naming: units, slugs and tmux sessions
# ---------------------------------------------------------------------------
#
# A *unit* is a working directory: a project, or one of its worktrees.
#   unit  := project[/worktree]
#   slug  := unit[@label]
#   tmux  := cx-<slug, with dots mangled the way tmux mangles them>
#
# Every tmux lookup uses the exact-match form `=name`. Without the `=`, tmux
# matches a target as a PREFIX: once `cx-api@review` exists,
# `has-session -t cx-api` succeeds and `attach -t cx-api` lands in the review
# session. That is silent, and it is wrong every time.

_unit() {
  if [ -n "${2:-}" ]; then printf '%s/%s' "$1" "$2"; else printf '%s' "$1"; fi
}

_slug() {
  local u
  u=$(_unit "$1" "${2:-}")
  if [ -n "${3:-}" ]; then printf '%s@%s' "$u" "$3"; else printf '%s' "$u"; fi
}

# _tmux_slug SLUG — the slug as tmux will actually store it.
# Only dots are mangled; slash and @ survive intact (verified against tmux 3.x).
_tmux_slug() { printf '%s' "$1" | tr '.' '_'; }

_tmux_name() { printf '%s%s' "$CX_TMUX_PREFIX" "$(_tmux_slug "$1")"; }

# _tmux_has NAME — exact-match existence test.
_tmux_has() { tmux has-session -t "=$1" 2>/dev/null; }

# ---------------------------------------------------------------------------
# Worktrees
# ---------------------------------------------------------------------------
#
# NOT stored in the registry. `git worktree list` already knows, and a second
# copy of a fact git maintains is a copy that drifts: a worktree removed with
# plain git would linger in cx forever. Deriving also means a worktree someone
# created by hand over SSH shows up in cx without being told about it.

# _worktree_base PROJECT_PATH — where cx puts this project's worktrees.
# Anchored to the project's own parent rather than the registry root, so an
# adopted project outside the root still gets its worktrees next to it.
_worktree_base() {
  printf '%s/%s/%s' "$(dirname "$1")" "$CX_WORKTREE_DIR" "$(basename "$1")"
}

# _worktrees_tsv PROJECT_PATH — name TAB path TAB branch, one line per
# worktree, excluding the main checkout itself.
#
# --porcelain rather than the human format: the plain output aligns columns and
# wraps the branch in brackets, both of which are documented as unstable.
_worktrees_tsv() {
  local ppath="$1"
  [ -e "$ppath/.git" ] || return 0
  git -C "$ppath" worktree list --porcelain 2>/dev/null | awk -v main="$ppath" '
    function flush(   n) {
      if (p != "" && p != main) {
        n = p; sub(/^.*\//, "", n)
        printf "%s\t%s\t%s\n", n, p, b
      }
    }
    /^worktree /  { flush(); p = substr($0, 10); b = "" }
    /^branch /    { b = substr($0, 8); sub(/^refs\/heads\//, "", b) }
    END           { flush() }
  '
}

# _worktree_path PROJECT_PATH NAME — resolve a worktree by name, or empty.
_worktree_path() {
  _worktrees_tsv "$1" | awk -F'\t' -v n="$2" '$1 == n { print $2; exit }'
}

# _unit_dir PROJECT WORKTREE — the working directory a slug refers to.
#
# Dies with the same exit codes the client already knows: 2 for "not found".
# CALL IT AS `dir=$(_unit_dir ...) || exit $?`. The `die` runs inside the
# command substitution's subshell, so it terminates that subshell and nothing
# else; without the explicit `|| exit`, a caller that feeds the result straight
# to printf reports success and prints an empty line.
_unit_dir() {
  local name="$1" wt="${2:-}" path wpath
  path=$(_project_path "$name")
  [ -n "$path" ] || die "no such project: $name" 2
  if [ -z "$wt" ]; then
    printf '%s' "$path"
    return 0
  fi
  wpath=$(_worktree_path "$path" "$wt")
  [ -n "$wpath" ] || die "no such worktree: $name/$wt" 2
  printf '%s' "$wpath"
}

# ---------------------------------------------------------------------------
# Locating Claude Code
# ---------------------------------------------------------------------------

# _find_claude — absolute path to the claude binary, or empty.
#
# PATH is searched first (now that it includes ~/.local/bin), then the known
# install locations explicitly. The explicit list matters because tmux may
# reuse an already-running server whose environment predates our PATH fix, so
# anything we hand to `tmux send-keys` must not depend on PATH at all.
# _claude_supports BIN FLAG — does the installed Claude Code accept FLAG?
#
# Worth a subprocess because the alternative fails in the worst possible way:
# an unknown flag makes claude exit immediately inside the tmux pane, so the
# session appears to open and is then just a dead shell, with the actual error
# already scrolled past. Checking first turns that into a sentence.
#
# Degrades to "yes" when --help cannot be read at all: a probe that itself
# failed is not evidence of anything, and refusing to open would be worse than
# letting claude report the problem itself.
_CLAUDE_HELP=""
_claude_supports() {
  local bin="$1" flag="$2"
  if [ -z "$_CLAUDE_HELP" ]; then
    _CLAUDE_HELP=$("$bin" --help 2>/dev/null || printf '')
    [ -n "$_CLAUDE_HELP" ] || return 0
  fi
  case "$_CLAUDE_HELP" in
    *"$flag"*) return 0 ;;
    *) return 1 ;;
  esac
}

_find_claude() {
  local c
  if c=$(command -v claude 2>/dev/null) && [ -n "$c" ]; then
    printf '%s' "$c"
    return 0
  fi
  for c in \
    "$HOME/.local/bin/claude" \
    "$HOME/.claude/local/claude" \
    "$HOME/bin/claude" \
    /usr/local/bin/claude \
    /opt/homebrew/bin/claude; do
    [ -x "$c" ] && {
      printf '%s' "$c"
      return 0
    }
  done
  return 1
}

# ---------------------------------------------------------------------------
# Claude session store
# ---------------------------------------------------------------------------
#
# Claude Code stores per-project history under
#   ~/.claude/projects/<encoded-absolute-path>/*.jsonl
#
# where the encoding replaces EVERY character outside [A-Za-z0-9-] with a dash
# — not just the slashes. Verified against a real store: no encoded directory
# name on disk contains any other character, and
#
#   /home/u/projects/api            -> -home-u-projects-api
#   /home/u/projects/.worktrees/api -> -home-u-projects--worktrees-api
#
# The dot is the one that matters, and getting it wrong was a real bug: cx puts
# every worktree under ".worktrees", so a slashes-only encoding pointed at a
# directory that never exists and silently reported no sessions for every
# worktree cx has ever made. `cx ls` showed "?" and the first open of a
# worktree could not adopt an existing conversation.
#
# This is an OBSERVED layout, not a documented API. Everything here degrades
# to "unknown" rather than failing if the directory is absent, so a future
# Claude Code change costs one display column instead of breaking `cx ls`.

# _session_dir_name PATH — just the encoded directory name.
#
# The single place this transformation is written down. It used to be spelled
# out twice — here and in _derive_dir — and the copies disagreed about the dot,
# so `cx ls` reported no history for exactly the directories `cx open` could
# still find it in. One function, two callers.
_session_dir_name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9-' '-'
}

_session_dir() {
  printf '%s/projects/%s' "$CX_CLAUDE_DIR" "$(_session_dir_name "$1")"
}

# _scan_sessions — one pass over the whole session store.
# Emits: <encoded-dir-name> TAB <count> TAB <newest-mtime>
#
# Scanning once for the entire host rather than once per project is what keeps
# `list` at O(1) subprocesses instead of O(projects).
_scan_sessions() {
  local base="$CX_CLAUDE_DIR/projects" d f name count newest m
  [ -d "$base" ] || return 0
  for d in "$base"/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    count=0
    newest=0
    for f in "$d"*.jsonl; do
      [ -e "$f" ] || continue
      count=$((count + 1))
      m=$(_mtime "$f" 2>/dev/null || printf 0)
      [ "${m:-0}" -gt "$newest" ] && newest="$m"
    done
    printf '%s\t%s\t%s\n' "$name" "$count" "$newest"
  done
}

# _newest_session_id DIR — the most recently touched conversation id for DIR.
#
# Leans on a SECOND property of the observed layout: each *.jsonl is named for
# the session id it contains (verified — the file's own .sessionId field equals
# its basename). Like everything else in this section it is allowed to fail;
# the caller then generates a fresh id instead.
_newest_session_id() {
  local d f best="" bestm=0 m
  d=$(_session_dir "$1")
  [ -d "$d" ] || return 1
  for f in "$d"/*.jsonl; do
    [ -e "$f" ] || continue
    m=$(_mtime "$f" 2>/dev/null || printf 0)
    if [ "${m:-0}" -gt "$bestm" ]; then
      bestm="$m"
      best="$f"
    fi
  done
  [ -n "$best" ] || return 1
  f=$(basename "$best")
  printf '%s' "${f%.jsonl}"
}

# ---------------------------------------------------------------------------
# Session identity
# ---------------------------------------------------------------------------
#
# THE PROBLEM: `claude --continue` resumes the most recent conversation *in the
# current directory*. Two cx sessions open on one project are two panes in the
# same directory, so both --continue onto the same conversation and the second
# one silently hijacks the first. Parallel sessions are impossible without
# giving each one a conversation of its own.
#
# THE FIX: every cx session pins a Claude session id, recorded here, and is
# launched with --resume <id> (falling back to --session-id <id> the first
# time, before any conversation exists to resume). Claude reuses the id on
# resume unless --fork-session is passed, so the pin stays valid.
#
# This file is a cache of ids, not state cx owns: delete it and every session
# starts a fresh conversation, which is annoying but not broken.

_uuid() {
  local u=""

  if [ -r /proc/sys/kernel/random/uuid ]; then
    u=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || printf '')
  fi
  if [ -z "$u" ] && have uuidgen; then
    # macOS uuidgen returns uppercase; --session-id wants a canonical UUID.
    u=$(uuidgen 2>/dev/null | tr 'A-Z' 'a-z' || printf '')
  fi
  if [ -z "$u" ] && [ -r /dev/urandom ]; then
    # No uuidgen (common on minimal images). Build a v4 by hand: version nibble
    # forced to 4, variant nibble to one of 8/9/a/b.
    u=$(od -An -tx1 -N16 /dev/urandom 2>/dev/null | tr -d ' \n' | awk '{
      v = substr("89ab", (index("0123456789abcdef", substr($0, 17, 1)) % 4) + 1, 1)
      printf "%s-%s-4%s-%s%s-%s\n",
        substr($0, 1, 8), substr($0, 9, 4), substr($0, 14, 3),
        v, substr($0, 18, 3), substr($0, 21, 12)
    }')
  fi

  case "$u" in
    ????????-????-????-????-????????????) printf '%s' "$u" ;;
    *) return 1 ;;
  esac
}

_sessions_ensure() {
  [ -e "$CX_SESSIONS" ] && return 0
  mkdir -p "$(dirname "$CX_SESSIONS")"
  printf '{"version":1,"sessions":{}}\n' | _write_atomic "$CX_SESSIONS"
}

_session_uuid_get() {
  [ -e "$CX_SESSIONS" ] || return 1
  local u
  u=$(jq -r --arg s "$1" '.sessions[$s].uuid // empty' "$CX_SESSIONS" 2>/dev/null) || return 1
  [ -n "$u" ] || return 1
  printf '%s' "$u"
}

# Merges rather than replaces: the entry also carries `dangerous`, and
# re-pinning a uuid must not quietly drop it.
_session_uuid_set() {
  _sessions_ensure
  _lock
  # shellcheck disable=SC2064
  trap "_unlock" EXIT INT TERM
  jq --arg s "$1" --arg u "$2" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '.sessions[$s] = ((.sessions[$s] // {}) + {uuid: $u, created_at: $t})' \
    "$CX_SESSIONS" >"$CX_SESSIONS.new" || {
    _unlock
    return 1
  }
  mv -f "$CX_SESSIONS.new" "$CX_SESSIONS"
  _unlock
  trap - EXIT INT TERM
}

# _session_set_perm_mode SLUG MODE — record how a session was STARTED.
#
# Permission mode is fixed when the pane's claude process launches, so it
# cannot be changed by reattaching, and from inside an attached session there
# is nothing to see — the prompts simply never come. Recording it is what lets
# `cx status` show it and a later `cx open` say so instead of silently handing
# over a session running under rules you did not choose.
#
# An empty MODE DELETES the key rather than storing a default. Two reasons:
# absent already means "Claude's own default" everywhere that reads it, and
# storing the negative would create an entry for every session that has
# nothing else worth recording — turning this file from a list of pins into a
# list of every session ever opened. Clearing still has to happen explicitly,
# because a previous session under the same slug may have set it and a stale
# value would make cx status lie about the session running now.
_session_set_perm_mode() {
  # Nothing to clear and nothing to record: leave the file untouched, and do
  # not create it just to say "default".
  if [ -z "$2" ] && [ ! -e "$CX_SESSIONS" ]; then
    return 0
  fi
  _sessions_ensure
  _lock
  # shellcheck disable=SC2064
  trap "_unlock" EXIT INT TERM
  # has($s) rather than a null test: `.sessions[$s] |= ...` on a missing key
  # CREATES it holding null, which is how an "entry created for every session
  # ever opened" crept back in via the clearing path.
  jq --arg s "$1" --arg m "$2" '
    if $m != "" then
      .sessions[$s] = ((.sessions[$s] // {}) + {perm_mode: $m})
    elif (.sessions | has($s)) then
      # `dangerous` is the pre-0.3.0 spelling; drop it here too so an upgraded
      # agent does not leave a stale marker behind after a plain restart.
      .sessions[$s] |= (del(.perm_mode) | del(.dangerous))
      # An entry that held nothing but the marker is now empty; drop it.
      | if .sessions[$s] == {} then del(.sessions[$s]) else . end
    else . end' \
    "$CX_SESSIONS" >"$CX_SESSIONS.new" || {
    _unlock
    return 1
  }
  mv -f "$CX_SESSIONS.new" "$CX_SESSIONS"
  _unlock
  trap - EXIT INT TERM
}

# _session_perm_mode SLUG — the recorded mode, or empty.
# Falls back to the boolean `dangerous` that 0.2.1 wrote, so a session started
# before an agent upgrade is still reported correctly while it keeps running.
_session_perm_mode() {
  [ -e "$CX_SESSIONS" ] || return 0
  jq -r --arg s "$1" \
    '.sessions[$s] | (.perm_mode // (if .dangerous == true then "bypassPermissions" else "" end)) // ""' \
    "$CX_SESSIONS" 2>/dev/null || printf ''
}

# _session_is_dangerous SLUG — true if that session bypasses every check.
_session_is_dangerous() {
  [ "$(_session_perm_mode "$1")" = bypassPermissions ]
}

# _session_forget UNIT — drop UNIT's pins, its labelled sessions, and (when
# UNIT is a project) its worktrees'. Called when the thing they name is gone,
# so the file does not accumulate ids for directories that no longer exist.
_session_forget() {
  [ -e "$CX_SESSIONS" ] || return 0
  _lock
  # shellcheck disable=SC2064
  trap "_unlock" EXIT INT TERM
  jq --arg u "$1" '
    .sessions |= with_entries(select(
      .key != $u
      and (.key | startswith($u + "@") | not)
      and (.key | startswith($u + "/") | not)
    ))' "$CX_SESSIONS" >"$CX_SESSIONS.new" || {
    _unlock
    return 1
  }
  mv -f "$CX_SESSIONS.new" "$CX_SESSIONS"
  _unlock
  trap - EXIT INT TERM
}

# _session_uuid_ensure SLUG DIR — the conversation id this session should use.
_session_uuid_ensure() {
  local slug="$1" dir="$2" u=""

  if u=$(_session_uuid_get "$slug"); then
    printf '%s' "$u"
    return 0
  fi

  # The first open of a project's DEFAULT session adopts whatever conversation
  # is already newest in that directory, rather than starting an empty one.
  # Without this, upgrading cx would appear to lose your history: `cx open api`
  # has always meant "carry on where I left off", and it still does — it is
  # just pinned from now on. Labelled sessions are new by definition and get a
  # fresh conversation.
  case "$slug" in
    *@*) ;;
    *) u=$(_newest_session_id "$dir" 2>/dev/null || printf '') ;;
  esac

  [ -n "$u" ] || u=$(_uuid) || return 1
  _session_uuid_set "$slug" "$u" || return 1
  printf '%s' "$u"
}

# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------

# Set by cmd_list before it calls _derive_dir / _live_count. Globals rather
# than arguments because the session scan is one large string and every project
# and worktree needs it; passing it per call would copy it dozens of times.
_SESSION_SCAN=""
_STORE_PRESENT=false
_LIVE_UNITS=""

# _derive_dir PATH WANT_GIT — branch TAB dirty TAB sessions TAB last_active.
#
# Shared by projects and worktrees: both are ordinary working directories as
# far as git and the Claude session store are concerned.
_derive_dir() {
  local path="$1" want_git="$2" branch="" dirty="" scount="" slast="" enc row

  # `-e` not `-d`: a worktree's .git is a FILE containing a gitdir: pointer, so
  # a -d test silently reports every worktree as "not a repository".
  if [ -n "$path" ] && [ -e "$path/.git" ]; then
    # symbolic-ref first: it names the branch even before the first commit,
    # where rev-parse --abbrev-ref just reports the literal "HEAD". A fresh
    # `cx new` project has no commits, so that is the common case.
    # Falling back to a short sha covers detached HEAD.
    branch=$(git -C "$path" symbolic-ref --short HEAD 2>/dev/null ||
      git -C "$path" rev-parse --short HEAD 2>/dev/null || printf '')
    if [ "$want_git" = 1 ]; then
      # Expensive on large repos: stats the whole worktree. Opt-in only.
      if [ -n "$(git -C "$path" status --porcelain 2>/dev/null | head -1)" ]; then
        dirty=1
      else
        dirty=0
      fi
    fi
  fi

  if [ "$_STORE_PRESENT" = true ] && [ -n "$path" ]; then
    enc=$(_session_dir_name "$path")
    row=$(printf '%s\n' "$_SESSION_SCAN" | awk -F'\t' -v k="$enc" '$1 == k {print $2 "\t" $3; exit}')
    if [ -n "$row" ]; then
      scount="${row%%	*}"
      slast="${row##*	}"
    else
      # The store exists but this directory has no history yet: genuinely zero,
      # as opposed to "we cannot tell".
      scount=0
      slast=0
    fi
  fi

  printf '%s\t%s\t%s\t%s' "$branch" "$dirty" "$scount" "$slast"
}

# _live_count UNIT — how many tmux sessions are running for a unit.
# UNIT is the tmux-mangled form, because that is what tmux reported.
_live_count() {
  printf '%s\n' "$_LIVE_UNITS" | awk -F'\t' -v u="$1" '$1 == u { n++ } END { print n + 0 }'
}

cmd_list() {
  local want_git=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --git) want_git=1 ;;
      --json) ;; # always JSON; accepted for symmetry with the client
      *) ;;
    esac
    shift
  done

  _registry_ensure

  # One tmux query for the whole host, not one per project.
  local live=""
  if have tmux; then
    live=$(tmux list-sessions -F '#{session_name}' 2>/dev/null || printf '')
  fi

  # Reduce the raw session names to "unit TAB label" once. Splitting at the
  # LAST component matters: cx-api and cx-api@review and cx-api/wt@review are
  # three different things, and a prefix test conflates all three.
  _LIVE_UNITS=$(printf '%s\n' "$live" | awk -v pre="$CX_TMUX_PREFIX" '
    index($0, pre) == 1 {
      s = substr($0, length(pre) + 1)
      i = index(s, "@")
      if (i > 0) printf "%s\t%s\n", substr(s, 1, i - 1), substr(s, i + 1)
      else       printf "%s\t\n", s
    }')

  _SESSION_SCAN=$(_scan_sessions)
  _STORE_PRESENT=false
  [ -d "$CX_CLAUDE_DIR/projects" ] && _STORE_PRESENT=true

  # Derived facts as TSV, merged by a single jq invocation below.
  local derived="" wt_derived="" name path nlive wname wpath wline
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    path=$(_project_path "$name")

    nlive=$(_live_count "$(_tmux_slug "$name")")
    derived="$derived$name	$(_derive_dir "$path" "$want_git")	$nlive
"

    # Worktrees, straight from git. One extra subprocess per project, and it
    # only reads .git/worktrees rather than touching the working tree.
    [ -n "$path" ] || continue
    while IFS="$(printf '\t')" read -r wname wpath; do
      [ -n "$wname" ] || continue
      nlive=$(_live_count "$(_tmux_slug "$name/$wname")")
      # _derive_dir recomputes the branch rather than trusting the porcelain
      # one, because it is the path that also handles a detached HEAD.
      wline=$(_derive_dir "$wpath" "$want_git")
      wt_derived="$wt_derived$name	$wname	$wpath	$wline	$nlive
"
    done <<EOF
$(_worktrees_tsv "$path" | cut -f1,2)
EOF
  done <<EOF
$(jq -r '.projects[].name' "$CX_REGISTRY" 2>/dev/null)
EOF

  jq -c --arg derived "$derived" \
    --arg wt "$wt_derived" \
    --arg host "$(hostname 2>/dev/null || printf 'unknown')" \
    --argjson store "$_STORE_PRESENT" '
    def cell: if . == "" then null else . end;
    def num:  if . == "" or . == "0" then null else (. | tonumber) end;

    ($derived
     | split("\n")
     | map(select(length > 0) | split("\t"))
     | map({
         key: .[0],
         value: {
           branch:      (.[1] | cell),
           dirty:       (if .[2] == "" then null else (.[2] == "1") end),
           sessions:    (if .[3] == "" then null else (.[3] | tonumber) end),
           last_active: (.[4] | num),
           tmux_count:  (.[5] | tonumber),
           tmux_live:   ((.[5] | tonumber) > 0)
         }
       })
     | from_entries) as $d

    | ($wt
     | split("\n")
     | map(select(length > 0) | split("\t"))
     | map({
         project: .[0],
         wt: {
           name:        .[1],
           path:        .[2],
           branch:      (.[3] | cell),
           dirty:       (if .[4] == "" then null else (.[4] == "1") end),
           sessions:    (if .[5] == "" then null else (.[5] | tonumber) end),
           last_active: (.[6] | num),
           tmux_count:  (.[7] | tonumber),
           tmux_live:   ((.[7] | tonumber) > 0)
         }
       })
     | group_by(.project)
     | map({key: .[0].project, value: map(.wt)})
     | from_entries) as $w

    | {
        host: $host,
        root: .root,
        session_store: $store,
        projects: (.projects | map(
          . + ($d[.name] // {}) + {worktrees: ($w[.name] // [])}
        ))
      }' "$CX_REGISTRY"
}

# ---------------------------------------------------------------------------
# new
# ---------------------------------------------------------------------------

cmd_new() {
  local name="" repo="" root=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        shift
        repo="${1:-}"
        ;;
      --root)
        shift
        root="${1:-}"
        ;;
      -*) die "unknown option: $1" 3 ;;
      *) [ -z "$name" ] && name="$1" ;;
    esac
    shift
  done

  _validate_name "$name"
  _registry_ensure

  # tmux rewrites a dot to an underscore in a session name, so "my.app" and
  # "my_app" would both live in cx-my_app and silently share one session.
  # Cheap to prevent at creation, confusing to diagnose afterwards.
  local clash
  clash=$(jq -r --arg t "$(_tmux_slug "$name")" \
    '.projects[].name | select((. | gsub("\\."; "_")) == $t)' \
    "$CX_REGISTRY" 2>/dev/null | head -1) || clash=""
  if [ -n "$clash" ] && [ "$clash" != "$name" ]; then
    die "'$name' would share a tmux session with the existing project '$clash' (tmux treats . and _ alike)" 4
  fi

  [ -n "$root" ] || root=$(_registry_root)
  case "$root" in
    /*) ;;
    *) root="$HOME/$root" ;; # relative roots hang off the remote HOME
  esac

  local path="$root/$name"

  if [ -n "$(_project_get "$name")" ]; then
    die "project '$name' already exists in the registry" 4
  fi

  # Adopting an existing directory is fine and useful (a repo cloned by hand);
  # cloning into a non-empty one is not.
  if [ -n "$repo" ] && [ -d "$path" ] && [ -n "$(ls -A "$path" 2>/dev/null)" ]; then
    die "$path already exists and is not empty — clone manually or pick another name" 4
  fi

  mkdir -p "$root" || die "cannot create $root" 1

  if [ -n "$repo" ]; then
    log "cloning $repo"
    git clone --quiet "$repo" "$path" >&2 || die "git clone failed" 1
  elif [ ! -d "$path" ]; then
    mkdir -p "$path" || die "cannot create $path" 1
    git -C "$path" init --quiet >&2 2>/dev/null || true
  fi

  # Record what git actually knows, rather than trusting the argument: a clone
  # may redirect, and an adopted directory may already have a different remote.
  local actual_repo=""
  if [ -d "$path/.git" ]; then
    actual_repo=$(git -C "$path" remote get-url origin 2>/dev/null || printf '')
  fi
  [ -n "$actual_repo" ] || actual_repo="$repo"

  _lock
  # shellcheck disable=SC2064
  trap "_unlock" EXIT INT TERM

  # Re-check under the lock: two concurrent `cx new` calls for the same name
  # would otherwise both pass the check above and one would be lost.
  if [ -n "$(_project_get "$name")" ]; then
    _unlock
    die "project '$name' already exists in the registry" 4
  fi

  jq --arg name "$name" --arg path "$path" --arg repo "$actual_repo" \
    --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
    .projects += [{
      name: $name,
      path: $path,
      repo: (if $repo == "" then null else $repo end),
      created_at: $created
    }]' "$CX_REGISTRY" >"$CX_REGISTRY.new" || {
    _unlock
    die "failed to update the registry" 1
  }
  mv -f "$CX_REGISTRY.new" "$CX_REGISTRY"

  _unlock
  trap - EXIT INT TERM

  # Compact: the contract is one JSON value on stdout, and a line-oriented
  # client must not have to reassemble a pretty-printed object.
  jq -nc --arg name "$name" --arg path "$path" --arg repo "$actual_repo" \
    '{name:$name, path:$path, repo:(if $repo=="" then null else $repo end), created:true}'
}

# ---------------------------------------------------------------------------
# rm
# ---------------------------------------------------------------------------

cmd_rm() {
  local name="" purge=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --purge) purge=1 ;;
      -*) die "unknown option: $1" 3 ;;
      *) [ -z "$name" ] && name="$1" ;;
    esac
    shift
  done

  [ -n "$name" ] || die "usage: cx-agent rm <name> [--purge]" 3
  _registry_ensure

  local path
  path=$(_project_path "$name")
  [ -n "$path" ] || die "no such project: $name" 2

  # End every live session first — the project's own, its labelled ones, and
  # its worktrees' — or tmux keeps a working directory open on a path we are
  # about to delete.
  _kill_unit_sessions "$name" 1 >/dev/null || true

  # Worktrees hold a .git pointer back into the project's repository, so they
  # must go before it does. `git worktree remove` per worktree rather than one
  # rm -rf, so the repository's own bookkeeping is updated too.
  local wpath
  if [ "$purge" = 1 ]; then
    # Only the path column is needed here, so cut it out rather than reading
    # three fields and leaving two unused.
    while IFS= read -r wpath; do
      [ -n "$wpath" ] || continue
      _worktree_remove "$path" "$wpath" 1 || true
    done <<EOF
$(_worktrees_tsv "$path" | cut -f2)
EOF
    rm -rf "$(_worktree_base "$path")" 2>/dev/null || true
    # And the shared parent, if this was the last project using it. rmdir, so
    # it fails harmlessly while another project still has worktrees in there.
    rmdir "$(dirname "$(_worktree_base "$path")")" 2>/dev/null || true
  fi

  _lock
  # shellcheck disable=SC2064
  trap "_unlock" EXIT INT TERM

  jq --arg n "$name" '.projects |= map(select(.name != $n))' \
    "$CX_REGISTRY" >"$CX_REGISTRY.new" || {
    _unlock
    die "failed to update the registry" 1
  }
  mv -f "$CX_REGISTRY.new" "$CX_REGISTRY"

  _unlock
  trap - EXIT INT TERM

  local purged=false
  if [ "$purge" = 1 ]; then
    # Guard against deleting something outside a plausible project location,
    # however the registry came to contain it.
    case "$path" in
      / | /bin | /etc | /home | /usr | /var | "$HOME")
        die "refusing to delete $path" 1
        ;;
    esac
    [ -d "$path" ] && rm -rf "$path" && purged=true
  fi

  # Pinned conversation ids for a project that no longer exists are dead
  # weight, and would be silently inherited by a future project of the same
  # name — pointing it at a conversation about different code.
  _session_forget "$name"
  _goal_forget "$name" || true

  jq -nc --arg name "$name" --arg path "$path" --argjson purged "$purged" \
    '{name:$name, path:$path, removed:true, purged:$purged}'
}

# ---------------------------------------------------------------------------
# path
# ---------------------------------------------------------------------------

cmd_path() {
  local name="" wt=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --worktree)
        shift
        wt="${1:-}"
        ;;
      -*) die "unknown option: $1" 3 ;;
      *) [ -z "$name" ] && name="$1" ;;
    esac
    shift
  done

  [ -n "$name" ] || die "usage: cx-agent path <name> [--worktree W]" 3
  _registry_ensure
  local p
  p=$(_unit_dir "$name" "$wt") || exit $?
  printf '%s\n' "$p"
}

# ---------------------------------------------------------------------------
# open / stop / sessions
# ---------------------------------------------------------------------------

# _unit_sessions UNIT [CHILDREN] — live tmux session names belonging to a unit.
#
# CHILDREN=1 also matches the unit's worktrees, which is what project-wide
# operations (rm, stop --all) want and what per-session ones must not do.
_unit_sessions() {
  local unit="$1" children="${2:-0}" tunit
  have tmux || return 0
  tunit=$(_tmux_slug "$unit")
  tmux list-sessions -F '#{session_name}' 2>/dev/null |
    awk -v pre="$CX_TMUX_PREFIX" -v u="$tunit" -v kids="$children" '
      index($0, pre) == 1 {
        s = substr($0, length(pre) + 1)
        if (s == u)                              { print; next }
        if (index(s, u "@") == 1)                { print; next }
        if (kids == "1" && index(s, u "/") == 1) { print }
      }' || true
}

# _kill_unit_sessions UNIT [CHILDREN] — end them; prints how many were killed.
_kill_unit_sessions() {
  local n=0 s
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    if tmux kill-session -t "=$s" 2>/dev/null; then
      n=$((n + 1))
    fi
  done <<EOF
$(_unit_sessions "$1" "${2:-0}")
EOF
  printf '%s' "$n"
}

# cmd_open NAME [--worktree W] [--session L] --mode continue|resume|shell
#
# Attach to the session for a unit, creating it if needed.
#
# Four properties this shape buys, each learned from how the naive version
# misbehaves:
#
#   * The claude command is sent ONLY on creation. Re-opening an existing
#     session must reattach to whatever is there, not stack a second Claude on
#     top of the first.
#   * `attach -d` detaches other clients. A hard SSH drop leaves a phantom
#     client attached, and tmux sizes the window to the smallest one — so
#     without -d, reconnecting gives you a squashed display.
#   * Every -t target is the exact-match `=name` form. tmux resolves a bare
#     target as a prefix, so once cx-api@review exists, `-t cx-api` finds it —
#     and `cx open api` would silently attach to the review session.
#   * Claude is launched against a PINNED conversation id, not --continue.
#     --continue means "the newest conversation in this directory", which two
#     parallel sessions in one directory both resolve to the same way.
cmd_open() {
  local name="" wt="" label="" mode="continue" dangerous=0 detach=0
  local perm_mode="" model="" effort=""
  # Everything after `--`, quoted individually and handed to claude verbatim.
  local passthru=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --detach) detach=1 ;;
      --mode)
        shift
        mode="${1:-continue}"
        ;;
      --worktree)
        shift
        wt="${1:-}"
        ;;
      --session)
        shift
        label="${1:-}"
        ;;
      --permission-mode)
        shift
        perm_mode="${1:-}"
        ;;
      --model)
        shift
        model="${1:-}"
        ;;
      --effort)
        shift
        effort="${1:-}"
        ;;
      --dangerous) dangerous=1 ;;
      --)
        shift
        while [ $# -gt 0 ]; do
          passthru=("${passthru[@]+"${passthru[@]}"}" "$1")
          shift
        done
        break
        ;;
      -*) die "unknown option: $1" 3 ;;
      *) [ -z "$name" ] && name="$1" ;;
    esac
    shift
  done

  [ -n "$name" ] || die "usage: cx-agent open <name> [--worktree W] [--session L] [--mode MODE] [OPTIONS] [-- ARGS]" 3
  have tmux || die "tmux is not installed on this server" 1
  if [ -n "$wt" ]; then _validate_label "worktree name" "$wt"; fi
  if [ -n "$label" ]; then _validate_label "session label" "$label"; fi

  # --dangerous is the loud spelling of one particular permission mode. Accept
  # both, refuse to guess when they disagree.
  if [ "$dangerous" = 1 ]; then
    if [ -n "$perm_mode" ] && [ "$perm_mode" != bypassPermissions ]; then
      die "--dangerous conflicts with --permission-mode $perm_mode" 3
    fi
    perm_mode=bypassPermissions
  fi
  [ -n "$perm_mode" ] && _validate_perm_mode "$perm_mode"
  [ -n "$effort" ] && _validate_effort "$effort"

  if [ "$mode" = shell ]; then
    # A shell session runs no Claude, so every one of these would be dropped
    # on the floor. Saying so beats appearing to honour them.
    if [ -n "$perm_mode" ] || [ -n "$model" ] || [ -n "$effort" ] ||
      [ ${#passthru[@]} -gt 0 ]; then
      die "--mode shell starts no Claude, so Claude options have no effect" 3
    fi
  fi

  _registry_ensure
  local dir slug tname pane
  dir=$(_unit_dir "$name" "$wt") || exit $?
  [ -d "$dir" ] || die "directory is missing: $dir" 1
  slug=$(_slug "$name" "$wt" "$label")
  tname=$(_tmux_name "$slug")

  # send-keys takes a PANE target, and a pane target of "=name" does not
  # resolve — tmux answers "can't find pane". The trailing colon is what makes
  # it "the current window of exactly this session". Session-level commands
  # (has-session, kill-session, attach) take "=name" without it.
  pane="=$tname:"

  local uuid="" created=false
  if ! _tmux_has "$tname"; then
    # EVERYTHING that can fail happens before new-session. Creating the tmux
    # session first and then dying leaves an empty session behind that the
    # next `cx open` cheerfully reattaches to, so the failure turns into a
    # dead shell that claims to be your project.
    #
    # The absolute path, not a bare `claude`: tmux may attach to an existing
    # server whose environment was captured before our PATH fix, in which case
    # a bare name would not resolve inside the pane.
    local claude_bin
    claude_bin=$(_find_claude) || claude_bin=claude

    # Options common to every mode, assembled once. EVERY value goes through
    # cx_q: this string becomes a command line inside the pane, so a model
    # name or a passed-through argument containing a space or a quote would
    # otherwise be re-split by the pane's shell.
    local opts="" a
    if [ -n "$perm_mode" ]; then
      _claude_supports "$claude_bin" --permission-mode ||
        die "the Claude Code on this server has no --permission-mode; upgrade it" 1
      opts="$opts --permission-mode $(cx_q "$perm_mode")"
    fi
    if [ -n "$model" ]; then
      opts="$opts --model $(cx_q "$model")"
    fi
    if [ -n "$effort" ]; then
      _claude_supports "$claude_bin" --effort ||
        die "the Claude Code on this server has no --effort; upgrade it" 1
      opts="$opts --effort $(cx_q "$effort")"
    fi

    # Name the session after its cx slug so it is identifiable from INSIDE:
    # Claude shows it in the prompt box, the /resume picker and the terminal
    # title. Added silently and only when supported — it is a convenience, and
    # an older Claude Code must not fail to start over one.
    if _claude_supports "$claude_bin" "-n, --name"; then
      opts="$opts --name $(cx_q "$slug")"
    fi

    for a in "${passthru[@]+"${passthru[@]}"}"; do
      opts="$opts $(cx_q "$a")"
    done

    # Past the point of no return: from here nothing else can refuse.
    tmux new-session -d -s "$tname" -c "$dir" || die "could not create tmux session" 1
    created=true

    if [ "$perm_mode" = bypassPermissions ]; then
      log "WARNING: starting $slug with ALL permission checks bypassed"
      log "         Claude will not ask before editing files or running commands"
    elif [ -n "$perm_mode" ]; then
      log "note: starting $slug with permission mode $perm_mode"
    fi

    case "$mode" in
      continue)
        uuid=$(_session_uuid_ensure "$slug" "$dir" 2>/dev/null || printf '')
        if [ -n "$uuid" ]; then
          # Which flag depends on whether that conversation exists yet, and the
          # session store answers that directly — so there is no `cmd || other`
          # chain here. A chain would relaunch Claude every time the first one
          # exited non-zero, which is a real thing users hit.
          local flag=--session-id
          [ -f "$(_session_dir "$dir")/$uuid.jsonl" ] && flag=--resume
          tmux send-keys -t "$pane" \
            "$(cx_q "$claude_bin") $flag $(cx_q "$uuid")$opts" C-m
        else
          # No id could be generated (no uuidgen, no /dev/urandom, no procfs).
          # Degrade to the old single-session behavior rather than refusing.
          tmux send-keys -t "$pane" \
            "$(cx_q "$claude_bin") --continue$opts 2>/dev/null || $(cx_q "$claude_bin")$opts" C-m
        fi
        ;;
      resume) tmux send-keys -t "$pane" "$(cx_q "$claude_bin") --resume$opts" C-m ;;
      shell) : ;;
      *) die "unknown mode: $mode" 3 ;;
    esac

    # Record how it was started, including when the mode is Claude's default:
    # a previous session under the same slug may have set one, and a stale
    # value would describe a session that is no longer running.
    if [ "$mode" != shell ]; then
      _session_set_perm_mode "$slug" "$perm_mode" || true
    fi
  else
    # Reattaching. Everything above was fixed when the pane's claude launched,
    # so passing these options now changes nothing — and the difference is
    # invisible once you are attached. Say so in both directions.
    local live_mode
    live_mode=$(_session_perm_mode "$slug")

    if [ "$live_mode" = bypassPermissions ]; then
      log "WARNING: $slug is already running with ALL permission checks bypassed"
      [ "$perm_mode" = bypassPermissions ] ||
        log "         (restart it with: cx stop, then cx open)"
    elif [ -n "$live_mode" ] && [ "$live_mode" != "$perm_mode" ]; then
      log "note: $slug is already running with permission mode $live_mode"
    fi

    if [ -n "$perm_mode" ] && [ "$perm_mode" != "$live_mode" ]; then
      log "note: --permission-mode cannot be applied to a live session."
      log "      Stop it first: cx stop, then cx open."
    fi
    if [ -n "$model" ] || [ -n "$effort" ] || [ ${#passthru[@]} -gt 0 ]; then
      log "note: $slug is already running; model, effort and passed-through"
      log "      options only apply when a session is created."
    fi
  fi

  # Detached: everything above already did the work — created the session and
  # sent Claude the command. Only the attach is skipped, so this shares one
  # code path with the interactive open rather than reimplementing it.
  #
  # `created: true` does NOT mean ready. This returns the moment send-keys
  # lands, and Claude takes seconds to start; the caller polls `observe` until
  # the state leaves `fresh`. Waiting here instead would pin an SSH connection
  # open for the duration, and there is no portable timeout to bound it with.
  #
  # The permission mode is READ BACK rather than taken from the flag just
  # passed. On a session that already existed those two differ, and only the
  # recorded one is true of the claude actually running — a live session's
  # mode cannot be changed, so answering with what was asked for would be a
  # lie in exactly the case a driver most needs the truth.
  if [ "$detach" = 1 ]; then
    [ -n "$uuid" ] || uuid=$(_session_uuid_get "$slug" 2>/dev/null) || uuid=""
    local live_perm
    live_perm=$(_session_perm_mode "$slug")
    jq -nc --arg target "$slug" --arg tmux "$tname" --arg dir "$dir" \
      --arg uuid "$uuid" --arg mode "$mode" --arg perm "$live_perm" \
      --argjson created "$created" '{
        target:  $target,
        tmux:    $tmux,
        dir:     $dir,
        uuid:    (if $uuid == "" then null else $uuid end),
        mode:    $mode,
        created: $created,
        permission_mode: (if $perm == "" then null else $perm end),
        dangerous: ($perm == "bypassPermissions"),
        attached: false
      }'
    return 0
  fi

  exec tmux attach -d -t "=$tname"
}

cmd_stop() {
  local name="" wt="" label="" all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --worktree)
        shift
        wt="${1:-}"
        ;;
      --session)
        shift
        label="${1:-}"
        ;;
      --all) all=1 ;;
      -*) die "unknown option: $1" 3 ;;
      *) [ -z "$name" ] && name="$1" ;;
    esac
    shift
  done

  [ -n "$name" ] || die "usage: cx-agent stop <name> [--worktree W] [--session L] [--all]" 3
  have tmux || die "tmux is not installed on this server" 1

  local unit slug tname killed=0
  unit=$(_unit "$name" "$wt")

  if [ "$all" = 1 ]; then
    # Children too: "stop everything for this project" has to include the
    # worktrees, or work keeps running on a project the user thinks is idle.
    killed=$(_kill_unit_sessions "$unit" 1)
  else
    slug=$(_slug "$name" "$wt" "$label")
    tname=$(_tmux_name "$slug")
    if _tmux_has "$tname"; then
      tmux kill-session -t "=$tname" 2>/dev/null || die "could not stop the session" 1
      killed=1
    fi
  fi

  jq -nc --arg name "$name" --arg wt "$wt" --arg label "$label" \
    --argjson killed "$killed" '{
      name: $name,
      worktree: (if $wt == "" then null else $wt end),
      session:  (if $label == "" then null else $label end),
      stopped:  ($killed > 0),
      killed:   $killed
    } + (if $killed > 0 then {} else {reason: "no live session"} end)'
}

# _tmux_rows — one line per live tmux session:
#   name TAB attached TAB created TAB windows TAB activity TAB pane_command
#
# One call for the whole host, shared by `sessions` and `observe`. The first
# four fields are what `sessions` has always reported and their order is fixed;
# observe's two are appended, so adding more never disturbs the old readers.
#
# pane_current_command resolves to the active pane of the session's current
# window, which is where cx put Claude. session_activity is an epoch integer
# from tmux 2.2 on and a string before it, so the reader must tolerate both.
_tmux_rows() {
  have tmux || return 0
  tmux list-sessions \
    -F '#{session_name}	#{session_attached}	#{session_created}	#{session_windows}	#{session_activity}	#{pane_current_command}' \
    2>/dev/null || printf ''
}

# _project_slug_map — tmux-slug TAB project-name, one line per project.
#
# tmux rewrites a dot to an underscore, so a project called "my.app" runs in a
# session called "cx-my_app" and reversing that textually would invent a
# project that does not exist. Worktree names and session labels cannot contain
# a dot (see _validate_label), so only this one component needs the lookup.
_project_slug_map() {
  _registry_ensure
  local pname
  while IFS= read -r pname; do
    [ -n "$pname" ] || continue
    printf '%s\t%s\n' "$(_tmux_slug "$pname")" "$pname"
  done <<EOF
$(jq -r '.projects[].name' "$CX_REGISTRY" 2>/dev/null)
EOF
}

# cmd_sessions — live cx sessions on this host.
#
# One `tmux list-sessions`, filtered to our prefix. Sessions the user created
# by hand are none of our business and are excluded.
#
# The project name is recovered by lookup rather than by reading the tmux name:
# tmux rewrites a dot to an underscore, so a project called "my.app" runs in a
# session called "cx-my_app" and reversing that textually would invent a
# project that does not exist. Worktree names and session labels cannot contain
# a dot (see _validate_label), so only this one component needs the lookup.
cmd_sessions() {
  local raw="" map=""
  raw=$(_tmux_rows)
  map=$(_project_slug_map)

  # How each session was STARTED, which is the only place that is recorded —
  # the pane's claude process cannot be asked after the fact.
  local pins='{"sessions":{}}'
  if [ -e "$CX_SESSIONS" ]; then
    pins=$(jq -c '{sessions: (.sessions // {})}' "$CX_SESSIONS" 2>/dev/null) ||
      pins='{"sessions":{}}'
  fi

  printf '%s\n' "$raw" |
    jq -Rs --arg prefix "$CX_TMUX_PREFIX" --arg map "$map" \
      --argjson pins "$pins" \
      --arg host "$(hostname 2>/dev/null || printf 'unknown')" '
      ($map
       | split("\n")
       | map(select(length > 0) | split("\t"))
       | map({key: .[0], value: .[1]})
       | from_entries) as $m

      | def parse:
          . as $s
          | ($s | index("@")) as $at
          | (if $at == null
             then {unit: $s, label: null}
             else {unit: $s[0:$at], label: $s[$at+1:]} end)
          | . as $o
          | ($o.unit | index("/")) as $sl
          | $o + (if $sl == null
                  then {tproject: $o.unit, worktree: null}
                  else {tproject: $o.unit[0:$sl], worktree: $o.unit[$sl+1:]} end);

      split("\n")
      | map(select(length > 0) | split("\t"))
      | map(select(.[0] | startswith($prefix)))
      | map(. as $r
          | ($r[0] | ltrimstr($prefix) | parse) as $p
          | ($m[$p.tproject] // $p.tproject) as $project
          | ($project
             + (if $p.worktree == null then "" else "/" + $p.worktree end)
             + (if $p.label    == null then "" else "@" + $p.label    end)) as $target
          | {
              project:   $project,
              worktree:  $p.worktree,
              label:     $p.label,
              target:    $target,
              session:   $r[0],
              attached:  ($r[1] != "0"),
              created:   ($r[2] | tonumber? // null),
              windows:   ($r[3] | tonumber? // null),
              # `dangerous` is the pre-0.3.0 spelling, still honoured so a
              # session started before an agent upgrade reports correctly
              # while it keeps running.
              mode:      ($pins.sessions[$target] as $e
                          | $e.perm_mode
                            // (if $e.dangerous == true then "bypassPermissions" else null end)),
              dangerous: (($pins.sessions[$target] as $e
                           | $e.perm_mode == "bypassPermissions" or $e.dangerous == true) // false)
            })
      | {host: $host, sessions: .}'
}

# ---------------------------------------------------------------------------
# observe
# ---------------------------------------------------------------------------
#
# What `sessions` is to tmux, `observe` is to the conversation: the facts a
# driver needs in order to decide whether a session is working, waiting, or
# gone.
#
# It reports FACTS ONLY. Whether "quiet for ninety seconds with an unfinished
# tool call" counts as stuck is a policy question, and policy lives on the
# client, where the threshold is configurable and a unit test can drive the
# classifier as a pure function. See lib/activity.sh.
#
# This leans further on the session store than anything before it — see the
# "Claude session store" section above for why that is allowed but must never
# be load-bearing. Three properties are used here, all verified against real
# transcripts, none of them documented:
#
#   .type            twelve values seen in the wild, only two of which are
#                    messages. The LAST LINE OF A TRANSCRIPT IS USUALLY NOT A
#                    MESSAGE — `last-prompt`, `ai-title` and file-history
#                    entries all trail the final exchange. A reader that takes
#                    the last line and looks at its role is wrong nearly always.
#   .isSidechain     subagent turns are interleaved into the same file and
#                    OUTNUMBER main-thread entries about two to one. Filtering
#                    them is essential, not a refinement.
#   .message.stop_reason   on an assistant entry: `end_turn` means the turn is
#                    finished and Claude is waiting for a human; `tool_use`
#                    means it is mid-work. This is the whole idle/busy signal.
#
# Every one of them degrades to null, and the caller renders that as "unknown".

# How far back to look for the last main-thread message. Sidechains can bury
# the main thread under hundreds of lines, so the window has to be far larger
# than the number of messages actually wanted; it escalates once and then gives
# up rather than reading a 4 MB transcript in full on every poll.
CX_OBSERVE_SCAN="${CX_OBSERVE_SCAN:-500}"
CX_OBSERVE_SCAN_MAX="${CX_OBSERVE_SCAN_MAX:-5000}"

# _is_shell_cmd CMD — is this pane sitting at a shell, i.e. has Claude exited?
#
# Tested against the shells rather than for "claude": the binary has been
# `node` and is now `claude`, and a future rename would silently turn every
# live session into a dead one. An unrecognised command means "something is
# running", which is the safe answer.
_is_shell_cmd() {
  case "$1" in
    bash | sh | zsh | fish | dash | ksh | ash | csh | tcsh) return 0 ;;
    -bash | -sh | -zsh | -fish) return 0 ;;
    *) return 1 ;;
  esac
}

# _file_bytes FILE — size in bytes. `stat -c` is GNU-only and `stat -f` is BSD;
# `wc -c` is neither, and on a regular file it does not read the contents.
_file_bytes() {
  wc -c <"$1" 2>/dev/null | tr -d ' \n' || printf ''
}

# _transcript_messages FILE — main-thread messages from the tail of FILE, one
# compact JSON object per line, oldest first.
_transcript_messages() {
  local f="$1" scan out=""
  for scan in "$CX_OBSERVE_SCAN" "$CX_OBSERVE_SCAN_MAX"; do
    # `fromjson?` is load-bearing. A transcript is append-only and is being
    # written while we read it, so its final line is routinely a half-written
    # object. Without the `?` every poll of a busy session is a parse error.
    out=$(tail -n "$scan" "$f" 2>/dev/null | jq -Rc '
      fromjson? // empty
      | select(.isSidechain != true)
      | select(.type == "assistant" or .type == "user")
      | {
          role:        .type,
          at:          (.timestamp // null),
          stop_reason: (.message.stop_reason // null),
          tool_result: (has("toolUseResult")),
          tools:       [(.message.content // []) | .[]?
                        | select(type == "object" and .type == "tool_use") | .name],
          text:        ((.message.content // "")
                        | if type == "string" then .
                          else [.[]? | select(type == "object" and .type == "text")
                                     | .text // ""] | join("\n")
                          end
                        | .[0:400])
        }' 2>/dev/null) || out=""
    [ -n "$out" ] && break
  done
  printf '%s' "$out"
}

# _slug_parse SLUG — split a slug into _SP_PROJECT / _SP_WT / _SP_LABEL.
#
# Unambiguous because _validate_name rejects / and @ in a project name and
# _validate_label allows only [A-Za-z0-9_-] in the other two.
_slug_parse() {
  local s="$1" unit
  case "$s" in
    *@*)
      _SP_LABEL="${s##*@}"
      unit="${s%@*}"
      ;;
    *)
      _SP_LABEL=""
      unit="$s"
      ;;
  esac
  case "$unit" in
    */*)
      _SP_PROJECT="${unit%%/*}"
      _SP_WT="${unit#*/}"
      ;;
    *)
      _SP_PROJECT="$unit"
      _SP_WT=""
      ;;
  esac
}

# _observe_one SLUG ROWS TAIL — one session's facts, as a JSON object.
_observe_one() {
  local slug="$1" rows="$2" tail_n="$3"
  _slug_parse "$slug"
  local project="$_SP_PROJECT" wt="$_SP_WT" label="$_SP_LABEL"

  local tname dir="" uuid="" tfile="" msgs=""
  tname=$(_tmux_name "$slug")

  # A session whose project or worktree has been deleted still reports; the
  # driver needs to see that it is gone, not have observe abort on it.
  dir=$(_unit_dir "$project" "$wt" 2>/dev/null) || dir=""

  local trow="" alive=false attached=false created="" activity="" pcmd="" shell=false
  trow=$(printf '%s\n' "$rows" | awk -F'\t' -v n="$tname" '$1 == n { print; exit }') || trow=""
  if [ -n "$trow" ]; then
    alive=true
    [ "$(printf '%s' "$trow" | cut -f2)" != 0 ] && attached=true
    created=$(printf '%s' "$trow" | cut -f3)
    activity=$(printf '%s' "$trow" | cut -f5)
    pcmd=$(printf '%s' "$trow" | cut -f6)
    _is_shell_cmd "$pcmd" && shell=true
  fi

  uuid=$(_session_uuid_get "$slug" 2>/dev/null) || uuid=""
  [ -n "$uuid" ] && [ -n "$dir" ] && tfile="$(_session_dir "$dir")/$uuid.jsonl"

  # Has Claude ever run in this directory? A brand-new session writes no
  # transcript until its first exchange, so "up and waiting for its first
  # prompt" and "stuck on the trust prompt" are otherwise indistinguishable.
  # This does not settle it either, but it says which one is plausible: Claude
  # only asks about trusting a folder the first time it is run there.
  local seen_dir=false
  [ -n "$dir" ] && [ -d "$(_session_dir "$dir")" ] && seen_dir=true

  local present=false mtime="" bytes=""
  if [ -n "$tfile" ] && [ -f "$tfile" ]; then
    present=true
    mtime=$(_mtime "$tfile" 2>/dev/null) || mtime=""
    bytes=$(_file_bytes "$tfile")
    msgs=$(_transcript_messages "$tfile")
  fi

  jq -nc \
    --arg slug "$slug" --arg project "$project" --arg wt "$wt" --arg label "$label" \
    --arg dir "$dir" --arg tname "$tname" --arg uuid "$uuid" --arg tfile "$tfile" \
    --arg created "$created" --arg activity "$activity" --arg pcmd "$pcmd" \
    --arg mtime "$mtime" --arg bytes "$bytes" --arg msgs "$msgs" \
    --argjson alive "$alive" --argjson attached "$attached" --argjson shell "$shell" \
    --argjson present "$present" --argjson seen_dir "$seen_dir" --argjson tail_n "$tail_n" '
    def cell: if . == "" then null else . end;
    def num:  if . == "" then null else (tonumber? // null) end;

    ($msgs | split("\n") | map(select(length > 0) | fromjson? // empty)) as $m
    | {
        target:   $slug,
        project:  $project,
        worktree: ($wt    | cell),
        label:    ($label | cell),
        dir:      ($dir   | cell),
        tmux: {
          name:     $tname,
          alive:    $alive,
          attached: $attached,
          shell:    $shell,
          command:  ($pcmd     | cell),
          created:  ($created  | num),
          activity: ($activity | num)
        },
        transcript: {
          uuid:      ($uuid  | cell),
          path:      ($tfile | cell),
          present:   $present,
          # false means Claude has never run in this directory, so a first-run
          # prompt (trust this folder?) is the likely reason nothing is written.
          dir_seen:  $seen_dir,
          mtime:     ($mtime | num),
          bytes:     ($bytes | num)
        },
        last: ($m | last),
        tail: (if $tail_n <= 0 then [] else $m[-$tail_n:] end)
      }'
}

# _observe_slugs — every session worth reporting on: the live tmux ones, plus
# every session cx has ever pinned that still has a transcript.
#
# The second half matters. A session whose Claude exited has no tmux entry at
# all, and a driver that only saw live sessions would conclude the work had
# never existed rather than that it needs reviving.
_observe_slugs() {
  local rows="$1" map="$2"
  {
    printf '%s\n' "$rows" |
      jq -Rr --arg prefix "$CX_TMUX_PREFIX" --arg map "$map" '
        ($map
         | split("\n")
         | map(select(length > 0) | split("\t"))
         | map({key: .[0], value: .[1]})
         | from_entries) as $m
        | split("\n")
        | .[]
        | select(length > 0)
        | split("\t")[0]
        | select(startswith($prefix))
        | ltrimstr($prefix)
        # Recover the project from the registry rather than un-mangling the
        # tmux name: tmux turned "my.app" into "my_app" and there is no way
        # back from the string alone.
        | . as $s
        | (($s | index("@")) as $at
           | if $at == null then {unit: $s, suffix: ""}
             else {unit: $s[0:$at], suffix: $s[$at:]} end)
        | . as $o
        | (($o.unit | index("/")) as $sl
           | if $sl == null then {p: $o.unit, rest: ""}
             else {p: $o.unit[0:$sl], rest: $o.unit[$sl:]} end)
        | (($m[.p] // .p) + .rest + $o.suffix)' 2>/dev/null || printf ''
    [ -e "$CX_SESSIONS" ] && jq -r '.sessions | keys[]' "$CX_SESSIONS" 2>/dev/null
  } | sort -u | grep -v '^$' || true
}

cmd_observe() {
  local name="" wt="" label="" all=0 tail_n=6
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=1 ;;
      --tail)
        shift
        tail_n="${1:-6}"
        ;;
      --worktree)
        shift
        wt="${1:-}"
        ;;
      --session)
        shift
        label="${1:-}"
        ;;
      -*) die "unknown option: $1" 3 ;;
      *) [ -z "$name" ] && name="$1" ;;
    esac
    shift
  done

  case "$tail_n" in
    '' | *[!0-9]*) die "--tail wants a number" 3 ;;
  esac

  [ "$all" = 1 ] || [ -n "$name" ] ||
    die "usage: cx-agent observe [--all | <name> [--worktree W] [--session L]] [--tail N]" 3

  _registry_ensure

  local rows map slugs=""
  rows=$(_tmux_rows)
  map=$(_project_slug_map)

  if [ "$all" = 1 ]; then
    slugs=$(_observe_slugs "$rows" "$map")
  else
    if [ -n "$wt" ]; then _validate_label "worktree name" "$wt"; fi
    if [ -n "$label" ]; then _validate_label "session label" "$label"; fi
    slugs=$(_slug "$name" "$wt" "$label")
  fi

  local out="" slug one
  while IFS= read -r slug; do
    [ -n "$slug" ] || continue
    one=$(_observe_one "$slug" "$rows" "$tail_n") || continue
    out="$out$one
"
  done <<EOF
$slugs
EOF

  printf '%s' "$out" | jq -sc \
    --arg host "$(hostname 2>/dev/null || printf 'unknown')" \
    --argjson now "$(date +%s)" \
    '{host: $host, observed_at: $now, sessions: .}'
}

# ---------------------------------------------------------------------------
# worktree
# ---------------------------------------------------------------------------

# _worktree_remove PROJECT_PATH WT_PATH FORCE
#
# git's output is captured (not merged into our stdout) purely to classify the
# failure; nothing from it is ever printed on stdout.
_worktree_remove() {
  local ppath="$1" wpath="$2" force="${3:-0}" out="" rc=0

  if [ "$force" = 1 ]; then
    out=$(git -C "$ppath" worktree remove --force "$wpath" 2>&1) || rc=$?
  else
    out=$(git -C "$ppath" worktree remove "$wpath" 2>&1) || rc=$?
  fi
  [ "$rc" -eq 0 ] && return 0

  case "$out" in
    *"is not a git command"* | *"usage: git worktree"* | *"unknown subcommand"*)
      # git < 2.17 has no `worktree remove`. Deleting the directory and
      # pruning is exactly what that version's own documentation prescribes.
      rm -rf "$wpath" 2>/dev/null || return 1
      git -C "$ppath" worktree prune 2>/dev/null || true
      return 0
      ;;
  esac

  printf '%s\n' "$out" >&2
  return 1
}

_wt_add() {
  local name="" wt="" branch="" from=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --branch)
        shift
        branch="${1:-}"
        ;;
      --from)
        shift
        from="${1:-}"
        ;;
      -*) die "unknown option: $1" 3 ;;
      *)
        if [ -z "$name" ]; then
          name="$1"
        elif [ -z "$wt" ]; then wt="$1"; fi
        ;;
    esac
    shift
  done

  [ -n "$name" ] && [ -n "$wt" ] || die "usage: cx-agent worktree add <project> <name> [--branch B] [--from REF]" 3
  _validate_label "worktree name" "$wt"
  have git || die "git is not installed on this server" 1

  _registry_ensure
  local path
  path=$(_project_path "$name")
  [ -n "$path" ] || die "no such project: $name" 2
  [ -e "$path/.git" ] || die "$name is not a git repository — worktrees need one" 1

  local existing
  existing=$(_worktree_path "$path" "$wt")
  [ -n "$existing" ] && die "worktree '$wt' already exists at $existing" 4

  [ -n "$branch" ] || branch="$wt"
  [ -n "$from" ] || from="HEAD"

  local base dir
  base=$(_worktree_base "$path")
  dir="$base/$wt"
  [ -e "$dir" ] && die "$dir already exists" 4
  mkdir -p "$base" || die "cannot create $base" 1

  # A repository with no commits has no HEAD, and `worktree add` fails with a
  # message about an invalid reference that says nothing about the real cause.
  git -C "$path" rev-parse --verify --quiet HEAD >/dev/null 2>&1 ||
    die "$name has no commits yet — commit something before adding a worktree" 1

  local created_branch=true
  if git -C "$path" show-ref --verify --quiet "refs/heads/$branch"; then
    # Checking out an existing branch. --from would be ignored, so say so
    # rather than appearing to honour it.
    [ "$from" = HEAD ] || log "branch $branch already exists; ignoring --from $from"
    created_branch=false
    git -C "$path" worktree add "$dir" "$branch" >&2 ||
      die "git worktree add failed (is $branch checked out somewhere else?)" 1
  else
    git -C "$path" worktree add -b "$branch" "$dir" "$from" >&2 ||
      die "git worktree add failed" 1
  fi

  jq -nc --arg project "$name" --arg name "$wt" --arg path "$dir" \
    --arg branch "$branch" --argjson created "$created_branch" \
    '{project:$project, name:$name, path:$path, branch:$branch,
      branch_created:$created, created:true}'
}

_wt_list() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: cx-agent worktree list <project>" 3
  _registry_ensure

  local path
  path=$(_project_path "$name")
  [ -n "$path" ] || die "no such project: $name" 2

  local tsv
  tsv=$(_worktrees_tsv "$path")
  jq -nc --arg project "$name" --arg path "$path" --arg tsv "$tsv" '
    {project: $project, path: $path,
     worktrees: ($tsv
       | split("\n")
       | map(select(length > 0) | split("\t"))
       | map({name: .[0], path: .[1],
              branch: (if .[2] == "" then null else .[2] end)}))}'
}

_wt_rm() {
  local name="" wt="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      -*) die "unknown option: $1" 3 ;;
      *)
        if [ -z "$name" ]; then
          name="$1"
        elif [ -z "$wt" ]; then wt="$1"; fi
        ;;
    esac
    shift
  done

  [ -n "$name" ] && [ -n "$wt" ] || die "usage: cx-agent worktree rm <project> <name> [--force]" 3
  _registry_ensure

  local path wpath
  path=$(_project_path "$name")
  [ -n "$path" ] || die "no such project: $name" 2
  wpath=$(_worktree_path "$path" "$wt")
  [ -n "$wpath" ] || die "no such worktree: $name/$wt" 2

  # Refuse BEFORE killing anything. Killing the sessions first and then hitting
  # git's "contains modified or untracked files" leaves the user with their
  # work stopped and the worktree still there — the worst of both outcomes.
  if [ "$force" != 1 ] && [ -n "$(git -C "$wpath" status --porcelain 2>/dev/null | head -1)" ]; then
    die "$name/$wt has uncommitted changes — commit them, or discard with --force" 4
  fi

  # Same reason project removal does it: tmux otherwise holds a working
  # directory open on a path that is about to stop existing.
  local killed
  killed=$(_kill_unit_sessions "$name/$wt" 0)

  _worktree_remove "$path" "$wpath" "$force" ||
    die "could not remove the worktree — retry with --force" 4

  # Tidy the per-project directory once its last worktree is gone. rmdir, not
  # rm -rf: it must fail harmlessly if anything is still in there.
  rmdir "$(_worktree_base "$path")" 2>/dev/null || true

  _session_forget "$name/$wt" || true
  _goal_forget "$name/$wt" || true

  jq -nc --arg project "$name" --arg name "$wt" --arg path "$wpath" \
    --argjson killed "$killed" \
    '{project:$project, name:$name, path:$path, removed:true, sessions_killed:$killed}'
}

cmd_worktree() {
  local sub="${1:-}"
  shift 2>/dev/null || true
  case "$sub" in
    add) _wt_add "$@" ;;
    list | ls) _wt_list "$@" ;;
    rm | remove) _wt_rm "$@" ;;
    *) die "usage: cx-agent worktree add|list|rm ..." 3 ;;
  esac
}

# ---------------------------------------------------------------------------
# goals
# ---------------------------------------------------------------------------
#
# A goal is a definition of done, plus the sessions working towards it.
#
# It lives on the server for the reason invariant 5 gives: servers own what
# cannot be derived, and a goal is the only thing in cx that nothing else
# knows. Keeping it on the client would mean losing it with the cache, and
# make it invisible from a second machine while the sessions it describes keep
# running here.
#
# A goal's MEMBERS are stored as written. A bare "api/authfix" means this
# host; a qualified "web2:api@tests" means another one. The agent validates
# only the bare ones — it cannot see other servers, and invariant 1 says it
# must not try. Resolving a qualified member is the client's job, which is the
# half that knows more than one server exists. That is what lets one goal span
# hosts without any client-side state or any replication between servers.
#
# What cx does NOT do is decide whether the definition of done is met. That is
# meaning, not structure, and it belongs to the driver — invariant 11.

# Bound the two growing lists. A goal that is revised or logged against for
# weeks should not turn its record into an unreadable wall of history.
CX_GOAL_HISTORY=50

_goals_ensure() {
  [ -e "$CX_GOALS" ] && return 0
  mkdir -p "$(dirname "$CX_GOALS")"
  printf '{"version":1,"goals":{}}\n' | _write_atomic "$CX_GOALS"
}

_goal_get() {
  [ -e "$CX_GOALS" ] || return 1
  local g
  g=$(jq -c --arg n "$1" '.goals[$n] // empty' "$CX_GOALS" 2>/dev/null) || return 1
  [ -n "$g" ] || return 1
  printf '%s' "$g"
}

# _goal_apply NAME FILTER [--arg ...] — read/modify/write one goal under lock.
#
# The same lock, temp file and atomic rename as _session_uuid_set. FILTER runs
# with the goal as `.` and must return the new goal; `updated_at` and the
# history caps are applied here so no caller can forget them.
_goal_apply() {
  local name="$1" filter="$2"
  shift 2
  _goals_ensure
  _lock
  # shellcheck disable=SC2064
  trap "_unlock" EXIT INT TERM
  jq --arg _n "$name" --arg _t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson _cap "$CX_GOAL_HISTORY" "$@" \
    ".goals[\$_n] |= ((. // null) | ($filter)
       | .updated_at = \$_t
       | .revisions = ((.revisions // []) | .[-\$_cap:])
       | .log       = ((.log       // []) | .[-\$_cap:]))" \
    "$CX_GOALS" >"$CX_GOALS.new" || {
    _unlock
    return 1
  }
  mv -f "$CX_GOALS.new" "$CX_GOALS"
  _unlock
  trap - EXIT INT TERM
}

# _goal_member_check MEMBER — a bare member must name something that exists.
#
# A qualified "host:unit" is stored unchecked: this server cannot see that
# host, and reaching for it would be the client's job even if it could.
_goal_member_check() {
  local m="$1" dir=""
  case "$m" in
    *:*) return 0 ;;
  esac
  _slug_parse "$m"
  # Inside a command substitution on purpose. _unit_dir reports "no such
  # project" by calling die, which in a subshell only ends the subshell — so
  # its exit code is caught here and the message that reaches the user names
  # the member the user actually typed.
  dir=$(_unit_dir "$_SP_PROJECT" "$_SP_WT" 2>/dev/null) || dir=""
  [ -n "$dir" ] || die "no such unit on this server: $m" 2
}

_goal_print() {
  jq -c --arg n "$1" '.goals[$n] // {}' "$CX_GOALS"
}

cmd_goal() {
  local sub="${1:-}"
  [ -n "$sub" ] || die "usage: cx-agent goal new|ls|show|dod|member|state|log|rm ..." 3
  shift

  case "$sub" in
    ls | list)
      _goals_ensure
      local want=""
      [ "${1:-}" = --state ] && want="${2:-}"
      jq -c --arg want "$want" \
        '{goals: [.goals[] | select($want == "" or .state == $want)]}' "$CX_GOALS"
      ;;

    show)
      local name="${1:-}"
      [ -n "$name" ] || die "usage: cx-agent goal show <name>" 3
      _goals_ensure
      _goal_get "$name" >/dev/null || die "no such goal: $name" 2
      _goal_print "$name"
      ;;

    new)
      local name="" members=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --member)
            shift
            members="$members${1:-}
"
            ;;
          -*) die "unknown option: $1" 3 ;;
          *) [ -z "$name" ] && name="$1" ;;
        esac
        shift
      done
      [ -n "$name" ] || die "usage: cx-agent goal new <name> [--member T]...  (dod on stdin)" 3
      _validate_label "goal name" "$name"
      _goals_ensure
      ! _goal_get "$name" >/dev/null 2>&1 || die "goal already exists: $name" 4

      local dod
      dod=$(cat)
      [ -n "$dod" ] || die "empty definition of done" 3

      local m
      while IFS= read -r m; do
        [ -n "$m" ] || continue
        _goal_member_check "$m"
      done <<EOF
$members
EOF

      _goal_apply "$name" '{
        name:       $_n,
        dod:        $dod,
        members:    ($members | split("\n") | map(select(length > 0)) | unique),
        state:      "active",
        created_at: $_t,
        revisions:  [],
        log:        []
      }' --arg dod "$dod" --arg members "$members" || die "could not write the goal" 1
      _goal_print "$name"
      ;;

    dod)
      local name="${1:-}"
      [ -n "$name" ] || die "usage: cx-agent goal dod <name>  (new dod on stdin)" 3
      _goals_ensure
      _goal_get "$name" >/dev/null || die "no such goal: $name" 2
      local dod
      dod=$(cat)
      [ -n "$dod" ] || die "empty definition of done" 3
      # Recorded, not overwritten. "Change the definition of done" is a normal
      # thing to do halfway through, and afterwards the only way to tell what
      # a session was actually asked for is to have kept the old text.
      _goal_apply "$name" '
        .revisions = ((.revisions // []) + [{at: $_t, field: "dod", from: .dod, to: $dod}])
        | .dod = $dod' --arg dod "$dod" || die "could not write the goal" 1
      _goal_print "$name"
      ;;

    member)
      local op="${1:-}" name="${2:-}" target="${3:-}"
      [ -n "$op" ] && [ -n "$name" ] && [ -n "$target" ] ||
        die "usage: cx-agent goal member add|rm <name> <target>" 3
      _goals_ensure
      _goal_get "$name" >/dev/null || die "no such goal: $name" 2
      case "$op" in
        add)
          _goal_member_check "$target"
          _goal_apply "$name" '.members = ((.members // []) + [$m] | unique)' --arg m "$target"
          ;;
        rm) _goal_apply "$name" '.members = ((.members // []) - [$m])' --arg m "$target" ;;
        *) die "usage: cx-agent goal member add|rm <name> <target>" 3 ;;
      esac || die "could not write the goal" 1
      _goal_print "$name"
      ;;

    state)
      local name="${1:-}" want="${2:-}"
      [ -n "$name" ] && [ -n "$want" ] || die "usage: cx-agent goal state <name> active|paused|done" 3
      case "$want" in
        active | paused | done) ;;
        *) die "state must be active, paused or done" 3 ;;
      esac
      _goals_ensure
      _goal_get "$name" >/dev/null || die "no such goal: $name" 2
      # Pausing touches nothing but this field. There is no process to signal:
      # the driver re-reads the goal every iteration and stops when it is not
      # active, so the tmux sessions carry on exactly as they were.
      _goal_apply "$name" '
        .revisions = ((.revisions // []) + [{at: $_t, field: "state", from: .state, to: $s}])
        | .state = $s' --arg s "$want" || die "could not write the goal" 1
      _goal_print "$name"
      ;;

    log)
      local name="" event="note" target=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --event)
            shift
            event="${1:-note}"
            ;;
          --target)
            shift
            target="${1:-}"
            ;;
          -*) die "unknown option: $1" 3 ;;
          *) [ -z "$name" ] && name="$1" ;;
        esac
        shift
      done
      [ -n "$name" ] || die "usage: cx-agent goal log <name> [--event E] [--target T]  (text on stdin)" 3
      _goals_ensure
      _goal_get "$name" >/dev/null || die "no such goal: $name" 2
      local text
      text=$(cat)
      _goal_apply "$name" '
        .log = ((.log // []) + [{at: $_t, event: $e, target: (if $tg == "" then null else $tg end), text: $x}])' \
        --arg e "$event" --arg tg "$target" --arg x "$text" || die "could not write the goal" 1
      _goal_print "$name"
      ;;

    rm)
      local name="${1:-}"
      [ -n "$name" ] || die "usage: cx-agent goal rm <name>" 3
      _goals_ensure
      _goal_get "$name" >/dev/null || die "no such goal: $name" 2
      _lock
      # shellcheck disable=SC2064
      trap "_unlock" EXIT INT TERM
      jq --arg n "$name" 'del(.goals[$n])' "$CX_GOALS" >"$CX_GOALS.new" || {
        _unlock
        die "could not write the goals file" 1
      }
      mv -f "$CX_GOALS.new" "$CX_GOALS"
      _unlock
      trap - EXIT INT TERM
      jq -nc --arg n "$name" '{name: $n, removed: true}'
      ;;

    *) die "unknown goal subcommand: $sub" 3 ;;
  esac
}

# _goal_forget UNIT — drop UNIT and its children from every goal's members.
#
# Called wherever _session_forget is, and for the same reason: a member that
# names a directory nobody can open again is a goal quietly pointing at
# nothing. The goal itself is left alone — losing one of two sessions does not
# mean the work is over, and deleting the user's stated intent because a
# worktree went away would be the wrong call to make on their behalf.
_goal_forget() {
  [ -e "$CX_GOALS" ] || return 0
  _lock
  # shellcheck disable=SC2064
  trap "_unlock" EXIT INT TERM
  jq --arg u "$1" '
    .goals |= with_entries(
      .value.members |= (map(select(
        . != $u
        and (startswith($u + "@") | not)
        and (startswith($u + "/") | not)
      )))
    )' "$CX_GOALS" >"$CX_GOALS.new" || {
    _unlock
    return 1
  }
  mv -f "$CX_GOALS.new" "$CX_GOALS"
  _unlock
  trap - EXIT INT TERM
}

# ---------------------------------------------------------------------------
# nudge
# ---------------------------------------------------------------------------
#
# Type a prompt into a session that is already running.
#
# ONE CONVERSATION, ONE WRITER. The obvious alternative — `claude -p --resume
# <uuid>` — is wrong, and quietly so. A cx session's tmux pane is already
# holding that conversation id, and a second claude process resuming the same
# id gives two writers appending to one transcript with no merge between them.
# Whichever finishes second wins the file and the other's turns are lost. So
# steering a LIVE session goes through its pane; `ask` is for units that have
# no live session.
#
# The text reaches tmux through a paste buffer rather than as a send-keys
# argument, which buys two things. A multi-line prompt is impossible with
# send-keys — the first newline submits, and the rest is typed into whatever
# comes next. And the prompt never becomes part of a command line on either
# side of the wire, so no quoting can mangle it. It arrives on stdin here for
# the same reason `ask` does.

# _tmux_paste PANE BUFFER TEXT — put TEXT in the pane's input and submit it.
_tmux_paste() {
  local pane="$1" buf="$2" text="$3" tmp="" rc=0

  # load-buffer takes a path, and "-" for stdin is a tmux 3.0 affordance. Try
  # it and fall back to a temp file rather than parsing a version number: the
  # fallback is what actually tells us whether this tmux supports it.
  if ! printf '%s' "$text" | tmux load-buffer -b "$buf" - 2>/dev/null; then
    tmp=$(mktemp "${TMPDIR:-/tmp}/cx-nudge.XXXXXX") || return 1
    chmod 600 "$tmp" 2>/dev/null || true
    printf '%s' "$text" >"$tmp"
    tmux load-buffer -b "$buf" "$tmp" 2>/dev/null || rc=1
    rm -f "$tmp"
    [ "$rc" = 0 ] || return 1
  fi

  # -d drops the buffer once it is pasted, so a prompt does not sit in tmux's
  # paste history afterwards. The pane target needs its trailing colon.
  tmux paste-buffer -d -b "$buf" -t "$pane" 2>/dev/null || return 1
  tmux send-keys -t "$pane" C-m 2>/dev/null || return 1
}

# _nudge_declined TARGET REASON — a refusal is a result, not a failure.
#
# Exit 0 with sent:false, the same shape `stop` uses when there was nothing to
# stop. A driver consumes this JSON either way, and a non-zero exit would make
# "the session is busy, try again shortly" indistinguishable from "the server
# is broken".
_nudge_declined() {
  jq -nc --arg target "$1" --arg reason "$2" \
    '{target: $target, sent: false, reason: $reason}'
}

cmd_nudge() {
  local name="" wt="" label="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --worktree)
        shift
        wt="${1:-}"
        ;;
      --session)
        shift
        label="${1:-}"
        ;;
      -*) die "unknown option: $1" 3 ;;
      *) [ -z "$name" ] && name="$1" ;;
    esac
    shift
  done

  [ -n "$name" ] || die "usage: cx-agent nudge <name> [--worktree W] [--session L] [--force]  (prompt on stdin)" 3
  have tmux || die "tmux is not installed on this server" 1
  if [ -n "$wt" ]; then _validate_label "worktree name" "$wt"; fi
  if [ -n "$label" ]; then _validate_label "session label" "$label"; fi

  _registry_ensure
  local dir slug tname pane
  dir=$(_unit_dir "$name" "$wt") || exit $?
  slug=$(_slug "$name" "$wt" "$label")
  tname=$(_tmux_name "$slug")
  pane="=$tname:"

  local prompt
  prompt=$(cat)
  [ -n "$prompt" ] || die "empty prompt" 3

  if ! _tmux_has "$tname"; then
    _nudge_declined "$slug" dead
    return 0
  fi

  # Never type into a pane somebody is looking at. The client decides the
  # busy/blocked cases from the transcript, because those depend on a
  # threshold the user sets; this one is a fact the agent can check itself,
  # and it is the one with a person on the other end of it.
  local attached=0
  attached=$(_tmux_rows | awk -F'\t' -v n="$tname" '$1 == n { print $2; exit }') || attached=0
  if [ "${attached:-0}" != 0 ] && [ "$force" != 1 ]; then
    _nudge_declined "$slug" attached
    return 0
  fi

  _tmux_paste "$pane" "cx-nudge-$$" "$prompt" ||
    die "could not send the prompt to $slug" 1

  jq -nc --arg target "$slug" --arg tmux "$tname" \
    --argjson chars "$(printf '%s' "$prompt" | wc -c | tr -d ' ')" '{
      target: $target,
      tmux:   $tmux,
      sent:   true,
      chars:  $chars
    }'
}

# ---------------------------------------------------------------------------
# ask
# ---------------------------------------------------------------------------

# cmd_ask NAME — one-shot question, prompt read from STDIN.
#
# The prompt travels over stdin rather than argv so it never passes through a
# shell at all. A prompt containing quotes, $(...), or newlines is impossible
# to mangle this way, and there is no length limit to worry about.
cmd_ask() {
  local name="" wt="" label="" dangerous=0
  local perm_mode="" model="" effort="" out_format="" schema="" budget=""
  local passthru=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --worktree)
        shift
        wt="${1:-}"
        ;;
      --session)
        shift
        label="${1:-}"
        ;;
      --permission-mode)
        shift
        perm_mode="${1:-}"
        ;;
      --model)
        shift
        model="${1:-}"
        ;;
      --effort)
        shift
        effort="${1:-}"
        ;;
      --output-format)
        shift
        out_format="${1:-}"
        ;;
      --json-schema)
        shift
        schema="${1:-}"
        ;;
      --max-budget-usd)
        shift
        budget="${1:-}"
        ;;
      --dangerous) dangerous=1 ;;
      --)
        shift
        while [ $# -gt 0 ]; do
          passthru=("${passthru[@]+"${passthru[@]}"}" "$1")
          shift
        done
        break
        ;;
      -*) die "unknown option: $1" 3 ;;
      *) [ -z "$name" ] && name="$1" ;;
    esac
    shift
  done

  [ -n "$name" ] || die "usage: cx-agent ask <name> [OPTIONS] [-- ARGS]  (prompt on stdin)" 3

  if [ "$dangerous" = 1 ]; then
    if [ -n "$perm_mode" ] && [ "$perm_mode" != bypassPermissions ]; then
      die "--dangerous conflicts with --permission-mode $perm_mode" 3
    fi
    perm_mode=bypassPermissions
  fi
  [ -n "$perm_mode" ] && _validate_perm_mode "$perm_mode"
  [ -n "$effort" ] && _validate_effort "$effort"
  case "${out_format:-text}" in
    text | json | stream-json) ;;
    *) die "unknown output format: $out_format (text, json, stream-json)" 3 ;;
  esac
  if [ -n "$wt" ]; then _validate_label "worktree name" "$wt"; fi
  if [ -n "$label" ]; then _validate_label "session label" "$label"; fi

  _registry_ensure
  local dir
  dir=$(_unit_dir "$name" "$wt") || exit $?

  local claude_bin
  claude_bin=$(_find_claude) || die "Claude Code is not installed on this server" 1

  local prompt
  prompt=$(cat)
  [ -n "$prompt" ] || die "empty prompt" 3

  cd "$dir" || die "cannot enter $dir" 1

  # Unlike open, this is a fresh process every time, so all of this applies to
  # this invocation only and there is nothing to record. Real argv here, not a
  # command line — nothing is going through a shell, so nothing needs quoting.
  local opt_args=()
  if [ -n "$perm_mode" ]; then
    opt_args=("${opt_args[@]+"${opt_args[@]}"}" --permission-mode "$perm_mode")
    [ "$perm_mode" = bypassPermissions ] &&
      log "WARNING: answering with ALL permission checks bypassed"
  fi
  [ -n "$model" ] && opt_args=("${opt_args[@]+"${opt_args[@]}"}" --model "$model")
  [ -n "$effort" ] && opt_args=("${opt_args[@]+"${opt_args[@]}"}" --effort "$effort")
  [ -n "$out_format" ] && opt_args=("${opt_args[@]+"${opt_args[@]}"}" --output-format "$out_format")
  [ -n "$schema" ] && opt_args=("${opt_args[@]+"${opt_args[@]}"}" --json-schema "$schema")
  [ -n "$budget" ] && opt_args=("${opt_args[@]+"${opt_args[@]}"}" --max-budget-usd "$budget")
  for _a in "${passthru[@]+"${passthru[@]}"}"; do
    opt_args=("${opt_args[@]+"${opt_args[@]}"}" "$_a")
  done

  # Without a label this stays what it always was: a one-shot with no history.
  # With one, the question joins that named session's conversation, so `cx ask
  # api@review` and `cx open api@review` are the same thread.
  if [ -n "$label" ]; then
    local slug uuid="" flag=--session-id
    slug=$(_slug "$name" "$wt" "$label")

    # ...but only when nothing else is holding that conversation. A live tmux
    # session already has a claude process resuming this id; starting a second
    # one gives two writers appending to a single transcript with no merge,
    # and the turns of whichever loses are silently orphaned. That is a real
    # bug this used to have, and the failure is invisible — the answer comes
    # back looking fine while history quietly goes missing.
    if have tmux && _tmux_has "$(_tmux_name "$slug")"; then
      die "$slug is running; a second claude on its conversation would lose turns — use nudge" 4
    fi

    uuid=$(_session_uuid_ensure "$slug" "$dir" 2>/dev/null || printf '')
    if [ -n "$uuid" ]; then
      [ -f "$(_session_dir "$dir")/$uuid.jsonl" ] && flag=--resume
      # Flag, its value, then -p, then the prompt. --resume takes an OPTIONAL
      # value, so with the prompt in between it would swallow the prompt as the
      # session id and leave Claude with nothing to answer.
      exec "$claude_bin" "$flag" "$uuid" \
        "${opt_args[@]+"${opt_args[@]}"}" -p "$prompt"
    fi
  fi

  "$claude_bin" "${opt_args[@]+"${opt_args[@]}"}" -p "$prompt"
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------

tool_version() {
  case "$1" in
    tmux) tmux -V 2>/dev/null | sed -n 's/^tmux \([0-9][^ ]*\).*/\1/p' ;;
    git) git --version 2>/dev/null | sed -n 's/^git version \([0-9.]*\).*/\1/p' ;;
    jq) jq --version 2>/dev/null | sed 's/^jq-//' ;;
    claude)
      local c
      c=$(_find_claude) && "$c" --version 2>/dev/null | head -1
      ;;
    bash) printf '%s' "${BASH_VERSION%%(*}" ;;
    *) printf '' ;;
  esac
}

cmd_doctor() {
  local claude_logged_in=false registry_ok=false root tmux_running=false

  # Best effort. Claude Code has used more than one location for credentials,
  # and on macOS it may use the Keychain, which is not visible from here — so
  # a false negative is possible. Treated as advisory: cx never blocks on it.
  if [ -s "$CX_CLAUDE_DIR/.credentials.json" ] ||
    [ -s "$HOME/.claude.json" ] ||
    [ -s "$CX_CLAUDE_DIR/credentials.json" ] ||
    [ -s "$HOME/.config/claude/.credentials.json" ]; then
    claude_logged_in=true
  fi

  if [ -r "$CX_REGISTRY" ] && jq -e . "$CX_REGISTRY" >/dev/null 2>&1; then
    registry_ok=true
  fi

  root=$(_registry_root)
  [ -n "$root" ] || root="$HOME/projects"

  tmux list-sessions >/dev/null 2>&1 && tmux_running=true

  jq -nc \
    --arg version "$CX_AGENT_VERSION" \
    --arg hostname "$(hostname 2>/dev/null || printf 'unknown')" \
    --arg root "$root" \
    --arg registry "$CX_REGISTRY" \
    --arg bash_v "$(tool_version bash)" \
    --arg tmux_v "$(tool_version tmux)" \
    --arg git_v "$(tool_version git)" \
    --arg jq_v "$(tool_version jq)" \
    --arg claude_v "$(tool_version claude)" \
    --argjson has_tmux "$(have tmux && printf true || printf false)" \
    --argjson has_git "$(have git && printf true || printf false)" \
    --argjson has_jq "$(have jq && printf true || printf false)" \
    --arg claude_path "$(_find_claude || printf '')" \
    --argjson has_claude "$(_find_claude >/dev/null && printf true || printf false)" \
    --argjson claude_logged_in "$claude_logged_in" \
    --argjson registry_ok "$registry_ok" \
    --argjson tmux_running "$tmux_running" \
    --argjson session_store "$([ -d "$CX_CLAUDE_DIR/projects" ] && printf true || printf false)" \
    '{
      agent_version: $version,
      # For diagnosis only — `cx doctor` shows what a server can do. The
      # feature gates deliberately use `version` instead: that is one cheap
      # line, where reaching this verb costs _find_claude, five tool_version
      # calls and four credential stats, and a gate runs before every call.
      capabilities: ["units", "detach", "observe", "nudge", "goals"],
      hostname: $hostname,
      project_root: $root,
      registry: { path: $registry, valid: $registry_ok },
      claude: {
        installed: $has_claude,
        path: (if $claude_path == "" then null else $claude_path end),
        version: (if $claude_v == "" then null else $claude_v end),
        logged_in: $claude_logged_in,
        session_store: $session_store
      },
      tools: {
        bash: { present: true,      version: $bash_v },
        tmux: { present: $has_tmux, version: $tmux_v, server_running: $tmux_running },
        git:  { present: $has_git,  version: $git_v },
        jq:   { present: $has_jq,   version: $jq_v }
      },
      ok: ($has_tmux and $has_git and $has_jq and $has_claude and $registry_ok)
    }'
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

usage() {
  cat >&2 <<'EOF'
cx-agent — server-side helper for cx (not intended for direct use)

  version                       print the agent version
  doctor                        dependency and credential state
  list [--git]                  projects, worktrees and derived state
  new <name> [--repo URL] [--root DIR]
  rm <name> [--purge]
  path <name> [--worktree W]
  open <name> [--worktree W] [--session L] [--detach]
              --mode continue|resume|shell
              [--permission-mode M] [--model M] [--effort E] [--dangerous]
              [-- CLAUDE_ARGS...]
  stop <name> [--worktree W] [--session L] [--all]
  sessions                      live cx tmux sessions
  observe [--all | <name> [--worktree W] [--session L]] [--tail N]
                                per-session facts: tmux, transcript, last turn
  nudge <name> [--worktree W] [--session L] [--force]
                                type a prompt into a live session (stdin)
  ask <name> [--worktree W] [--session L] [--permission-mode M] [--model M]
             [--effort E] [--output-format F] [--json-schema S]
             [--max-budget-usd N] [--dangerous] [-- CLAUDE_ARGS...]
  goal new <name> [--member T]...           definition of done on stdin
  goal ls [--state S] | show <name> | rm <name>
  goal dod <name>                           replace it (stdin), keeping history
  goal member add|rm <name> <target>
  goal state <name> active|paused|done
  goal log <name> [--event E] [--target T]  record what a driver did (stdin)

Claude options apply when a session is CREATED; reattaching cannot change
them. The permission mode is recorded so cx status can show it. --dangerous is
the loud spelling of --permission-mode bypassPermissions. Anything after `--`
is passed to Claude Code verbatim.
  worktree add <project> <name> [--branch B] [--from REF]
  worktree list <project>
  worktree rm <project> <name> [--force]

A unit is <project> or <project>/<worktree>; a session is <unit>[@<label>].

Output: JSON on stdout, human-readable messages on stderr.
EOF
}

main() {
  [ $# -gt 0 ] || {
    usage
    exit 3
  }
  local cmd="$1"
  shift

  case "$cmd" in
    version | --version | -V)
      printf '%s\n' "$CX_AGENT_VERSION"
      return 0
      ;;
    help | --help | -h)
      usage
      return 0
      ;;
  esac

  have jq || die "jq is required but not installed on this server" 1

  case "$cmd" in
    doctor) cmd_doctor "$@" ;;
    list) cmd_list "$@" ;;
    new) cmd_new "$@" ;;
    rm) cmd_rm "$@" ;;
    path) cmd_path "$@" ;;
    open) cmd_open "$@" ;;
    stop) cmd_stop "$@" ;;
    sessions) cmd_sessions "$@" ;;
    observe) cmd_observe "$@" ;;
    nudge) cmd_nudge "$@" ;;
    goal) cmd_goal "$@" ;;
    ask) cmd_ask "$@" ;;
    worktree | wt) cmd_worktree "$@" ;;
    *) die "unknown command: $cmd" 3 ;;
  esac
}

# Sourcing this file with CX_AGENT_NO_MAIN=1 defines its functions without
# running anything, which is how the unit tests reach _slug, _tmux_slug and
# _transcript_state. It is not a test-only hack bolted on: the file already
# takes CX_DATA_DIR, CX_REGISTRY, CX_SESSIONS and CX_CLAUDE_DIR from the
# environment for the same reason. Invariant 6 is untouched — nothing is
# factored out into lib/, the file is still one scp'able artifact.
[ "${CX_AGENT_NO_MAIN:-}" = 1 ] || main "$@"
